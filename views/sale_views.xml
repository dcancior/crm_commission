<odoo>
  <!-- Vista heredada para sale.order: se apoya en la vista oficial de ventas -->
  <record id="view_order_form_mechanic_line" model="ir.ui.view">
    <field name="name">sale.order.form.mechanic.line</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>

    <field name="arch" type="xml">

      <!--
      OBJETIVO GENERAL:
      Añadir a las líneas de pedido (sale.order.line) campos relacionados con el “mecánico”
      y reglas de visualización/alerta. La lógica se activa sólo en líneas de tipo servicio.
      -->

      <!-- 1) Inyección de flags en el TREE -->
      <xpath expr="//field[@name='order_line']/tree" position="inside">
        <field name="display_mechanic_fields" invisible="1"/>
        <field name="product_type" invisible="1"/>
        <field name="mechanic_is_placeholder" invisible="1"/>
        <!-- NUEVO: bandera para exentar líneas cuyo producto empiece con 'PAQ' -->
        <field name="mechanic_exempt" invisible="1"/>
      </xpath>

      <!-- 2) Decoración de fila (warning) con exención por 'PAQ*' -->
      <xpath expr="//field[@name='order_line']/tree" position="attributes">
        <attribute name="decoration-warning">
          (display_mechanic_fields) and (not mechanic_id or mechanic_is_placeholder) and (not mechanic_exempt)
        </attribute>
      </xpath>

      <!-- 3) Columna "Mecánico" antes del subtotal -->
      <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="before">
         <field name="mechanic_id"
           string="Mecánico"
           optional="show"
           domain="[('active','=',True), ('job_id.name', '=', 'Mecánico')]"
           attrs="{'readonly':[('display_mechanic_fields','=',False)]}"/>
      </xpath>

      <!-- 4) Costo mecánico (oculto siempre: es solo un cálculo interno de referencia,
           no se usa en ningún otro lugar del módulo) / Porcentaje mecánico según método -->
      <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">
        <field name="mechanic_cost_subtotal" invisible="1"/>
        <field name="porcentaje_comision_mecanico"
               string="Porcentaje mecánico"
               attrs="{'readonly':[('display_mechanic_fields','=',False)],
                       'invisible':[('display_mechanic_fields','=',False)],
                       'column_invisible':[('parent.mechanic_commission_calc_method','=','hours_cost')]}"/>
      </xpath>

      <!-- 4b) Campo auxiliar en el encabezado del pedido para column_invisible -->
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="mechanic_commission_calc_method" invisible="1"/>
      </xpath>

      <!-- 5) Inyección de flags en el FORM (grupo oculto) -->
      <xpath expr="//field[@name='order_line']/form" position="inside">
        <group invisible="1">
          <field name="display_mechanic_fields"/>
          <field name="product_type"/>
          <field name="mechanic_is_placeholder"/>
          <!-- NUEVO: misma bandera en el form -->
          <field name="mechanic_exempt"/>
          <!-- NUEVO: método de cálculo de comisión configurado en la compañía -->
          <field name="mechanic_commission_calc_method"/>
        </group>
      </xpath>

      <!-- 6) Grupo visible “Mecánico” en el FORM -->
      <xpath expr="//field[@name='order_line']/form//group[1]" position="after">
        <group string="Mecánico">
          <field name="mechanic_id"
                 domain="[('active','=',True), ('job_id.name', '=', 'Mecánico')]"/>
          <field name="mechanic_hours_required" readonly="1"
                 attrs="{'invisible':['|', ('display_mechanic_fields','=',False), ('mechanic_commission_calc_method','=','percent')]}"/>
          <field name="mechanic_cost_per_hour" readonly="1"
                 attrs="{'invisible':['|', ('display_mechanic_fields','=',False), ('mechanic_commission_calc_method','=','percent')]}"/>
          <field name="mechanic_cost_subtotal" readonly="1" invisible="1"/>
          <field name="porcentaje_comision_mecanico"
                 string="Porcentaje mecánico"
                 attrs="{'invisible':['|', ('display_mechanic_fields','=',False), ('mechanic_commission_calc_method','=','hours_cost')]}"/>
        </group>
      </xpath>

      <!-- 7) "Ruta" (route_id, de sale_stock) YA NO se oculta aquí.

           sale_stock declara ese campo con groups="stock.group_adv_location",
           así que Odoo lo borra del arch combinado de quien no tenga el grupo:
           el xpath se quedaba sin nodo y la actualización del módulo moría con
           "cannot be located in parent view". Tampoco se puede aislar en una
           vista con groups_id, porque Odoo 16 lo prohíbe en vistas heredadas.

           No se pierde nada: el campo solo aparece si se activan las rutas de
           varios pasos (grupo "Ubicaciones avanzadas") y, aun entonces, en la
           lista de líneas viene como optional="hide". -->

      <!-- 8) Ocultar "Plazo de entrega" (customer_lead, del módulo sale base):
           no se usa en este negocio; ocultarlo no afecta su cálculo interno,
           solo deja de ser editable/visible por línea. -->
      <xpath expr="//field[@name='order_line']//field[@name='customer_lead']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

    </field>
  </record>

</odoo>
