<odoo>

  <!-- ===== Subform dedicado para las líneas ===== -->
  <record id="view_commission_report_line_form" model="ir.ui.view">
    <field name="name">commission.report.wizard.line.form</field>
    <field name="model">commission.report.wizard.line</field>
    <field name="arch" type="xml">
      <form string="Pago de comisión (línea)">
        <group>
          <!-- Claves invisibles -->
          <field name="wizard_id" invisible="1" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
          <field name="payment_entry_id" invisible="1" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
          <field name="move_id" invisible="1" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>

          <!-- Solo lectura de la factura -->
          <field name="invoice_date" string="Fecha Factura" readonly="1"/>
          <!-- NUEVO: fecha en que el cliente terminó de pagar la factura -->
          <field name="invoice_payment_date" string="Fecha de pago" readonly="1"/>
          <field name="partner_id" string="Cliente" readonly="1" options="{'no_open': True, 'no_create_edit': True}"/>
          <field name="amount_untaxed" string="Total sin IVA" readonly="1"/>

          <!-- Regla de pago: factura pagada completa dentro del plazo -->
          <field name="commission_payable" readonly="1"/>
          <field name="not_payable_reason" readonly="1" attrs="{'invisible': [('not_payable_reason', '=', False)]}"/>

          <!-- Único editable (solo si la comisión es pagadera) -->
          <field name="payment_method" attrs="{'readonly': [('commission_payable', '=', False)]}"/>

          <!-- Sellos -->
          <!-- Aclaramos que esta es la fecha del registro de la comisión -->
          <field name="payment_datetime" string="Fecha pago comisión" readonly="1"/>
          <field name="payment_user_id" string="Registró" readonly="1"/>
          <field name="commission_paid" readonly="1" widget="boolean_toggle"/>
          <field name="commission_percent" string="% Comisión" readonly="1"/>
          <field name="commission_amount" readonly="1"/>
        </group>
      </form>
    </field>
  </record>

  <!-- ===== Vista principal del wizard ===== -->
  <record id="view_commission_report_wizard_form" model="ir.ui.view">
    <field name="name">commission.report.wizard.form</field>
    <field name="model">commission.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Reporte de Comisión (rango)" class="o_commission_report">
        <sheet>

          <!-- Moneda para formateo de campos monetary -->
          <field name="currency_id" invisible="1"/>
          <field name="is_large_period" invisible="1"/>
          <field name="request_id" invisible="1"/>
          <field name="needs_refresh" invisible="1"/>

          <!-- Filtros. Orden de captura: 1) Vendedor, 2) Periodo, 3) Filtro de pago -->
          <group string="Filtros" class="o_commission_filters">
            <field name="user_id" required="1" options="{'no_create_edit': True}" domain="[('sale_team_id.name', 'ilike', 'Ventas')]"/>
            <field name="period_mode" widget="radio" options="{'horizontal': true}"/>

            <!-- Por trimestre: al elegirlo se llenan las fechas; debajo, el rango que abarca -->
            <field name="quarter" widget="radio" options="{'horizontal': true}"
                   attrs="{'invisible': [('period_mode', '!=', 'quarter')], 'required': [('period_mode', '=', 'quarter')]}"/>
            <field name="period_label" string="Abarca" readonly="1"
                   attrs="{'invisible': [('period_mode', '!=', 'quarter')]}"/>

            <!-- Desde / Hasta en una sola línea (se acomoda en pantallas chicas) -->
            <label for="date_start" string="Desde / Hasta" attrs="{'invisible': [('period_mode', '!=', 'range')]}"/>
            <div class="o_commission_dates" attrs="{'invisible': [('period_mode', '!=', 'range')]}">
              <field name="date_start" required="1" class="oe_inline"/>
              <span class="mx-2 text-muted">al</span>
              <field name="date_end" required="1" class="oe_inline"/>
            </div>

            <field name="filter_payment"/>
            <!-- Orden actual de la tabla; lo sincroniza list_sort_sync.js al pulsar
                 un encabezado, para que el PDF salga en el mismo orden -->
            <field name="sort_field" invisible="1"/>
            <field name="sort_direction" invisible="1"/>
          </group>

          <!-- La tabla solo se carga al pulsar Consultar (no en cada cambio de filtro) -->
          <div class="mb-3" attrs="{'invisible': [('is_large_period', '=', True)]}">
            <button name="action_refresh" type="object" string="Consultar"
                    class="btn-primary" icon="fa-search"/>
          </div>
          <div class="alert alert-secondary" role="status"
               attrs="{'invisible': ['|', ('needs_refresh', '=', False), ('is_large_period', '=', True)]}">
            <i class="fa fa-info-circle me-2" role="img" aria-label="Información"/>
            Elige el vendedor, el periodo y el filtro, y pulsa <strong>Consultar</strong> para ver el reporte.
          </div>

          <!-- Periodo extenso: no se consulta en pantalla, se envía por correo -->
          <div class="alert alert-info" role="alert"
               attrs="{'invisible': ['|', ('is_large_period', '=', False), ('request_id', '!=', False)]}">
            <i class="fa fa-envelope me-2" role="img" aria-label="Correo"/>
            <field name="large_period_msg" nolabel="1" readonly="1"/>
            <div class="mt-2">Pulsa <strong>Enviar reporte a mi correo</strong> para solicitarlo.</div>
          </div>
          <div class="alert alert-success" role="status"
               attrs="{'invisible': ['|', ('is_large_period', '=', False), ('request_id', '=', False)]}">
            <i class="fa fa-check-circle me-2" role="img" aria-label="Solicitado"/>
            <strong>Tu reporte se está generando.</strong>
            Aquí no aparecerá nada: te llegará a tu correo electrónico en unos minutos,
            para no sobrecargar el servidor.
          </div>

          <!-- Totales / KPIs -->
          <group string="Totales -> Solo cuentan las facturas pagadas al 100% por el cliente dentro de 3 meses"
                 attrs="{'invisible': ['|', ('is_large_period', '=', True), ('needs_refresh', '=', True)]}">
            <group>
              <field name="commission_percent" readonly="1"/>
              <field name="lines_count" readonly="1"/>
              <field name="amount_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
              <field name="commission_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </group>
            <group>
              <field name="not_payable_count" readonly="1"/>
              <field name="commission_not_payable_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </group>
          </group>

          <notebook attrs="{'invisible': ['|', ('is_large_period', '=', True), ('needs_refresh', '=', True)]}">
            <page string="Facturas Comisionadas">
              <!-- Aviso del orden actual: solo pantalla, no sale en el PDF -->
              <div class="text-muted mb-2">
                <i class="fa fa-sort-amount-asc me-1" role="img" aria-label="Orden ascendente"
                   attrs="{'invisible': [('sort_direction', '=', 'desc')]}"/>
                <i class="fa fa-sort-amount-desc me-1" role="img" aria-label="Orden descendente"
                   attrs="{'invisible': [('sort_direction', '!=', 'desc')]}"/>
                <field name="sort_label" nolabel="1" readonly="1" class="oe_inline"/>
              </div>

              <!-- ÚNICA tabla: las líneas ya vienen filtradas desde Python con _load_lines() -->
              <field name="line_ids" nolabel="1" mode="tree" context="{'no_open': 0, 'default_wizard_id': active_id, 'form_view_ref': 'crm_commission.view_commission_report_line_form'}" options="{'no_open': False, 'no_create': True}">
                <tree create="0" edit="0" delete="0" decoration-danger="not commission_payable" decoration-warning="manual_payable">
                  <field name="commission_paid" readonly="1" widget="boolean_toggle"/> <!--Booleano pagado no pagado -->
                  <field name="commission_payable" readonly="1" force_save="1"/> <!-- Pagada completa en plazo -->
                  <field name="move_id" string="Factura" readonly="1" options="{'no_open': True, 'no_create_edit': True}"/> <!-- Número de factura-->
                  <field name="invoice_date" string="Fecha Factura" readonly="1"/> <!-- Fecha de factura -->
                  <!-- NUEVO: fecha en que el cliente terminó de pagar la factura -->
                  <field name="invoice_payment_date" string="Fecha de pago" readonly="1" force_save="1"/> <!-- Fecha de pago (cliente) -->
                  <field name="partner_id" string="Cliente" readonly="1" options="{'no_open': True, 'no_create_edit': True}"/> <!-- Cliente -->
                  <field name="payment_method" string="Forma de pago comisión" attrs="{'readonly': [('commission_payable', '=', False)]}"/> <!-- Se edita en el subform -->
                  <!-- Aclaramos que esta fecha es de la comisión -->
                  <field name="payment_datetime" string="Fecha pago comisión" readonly="1"/> <!-- Fecha/hora del pago de comisión -->
                  <field name="payment_user_id" string="Registró" readonly="1"/> <!-- Usuario que registró la comisión -->
                  <field name="amount_untaxed" string="Factura sin IVA" readonly="1"/>
                  <field name="commission_percent" string="% Comisión" readonly="1"/>
                  <field name="commission_amount" readonly="1"/>
                  <!-- Solo suma lo pagadero (cuadra con "Total Comisión") -->
                  <field name="commission_payable_amount" readonly="1" force_save="1" sum="Comisión a pagar"/>
                  <field name="not_payable_reason" string="Motivo" readonly="1" force_save="1" optional="show"/>
                  <field name="manual_payable" invisible="1"/>
                </tree>

                <!-- Subform inline (opcional) -->
                <form string="Pago de comisión" create="0" delete="0">
                  <group>
                    <field name="wizard_id" invisible="1" readonly="1" force_save="1"/>
                    <field name="payment_entry_id" invisible="1" readonly="1" force_save="1"/>
                    <field name="commission_paid" readonly="1" widget="boolean_toggle"/> <!--Booleano pagado no pagado -->
                    <field name="move_id" string="Factura" readonly="1" options="{'no_open': True, 'no_create_edit': True}"/> <!-- Número de factura-->
                    <field name="invoice_date" string="Fecha Factura" readonly="1"/> <!-- Fecha de factura -->
                    <!-- NUEVO: fecha de pago del cliente -->
                    <field name="invoice_payment_date" string="Fecha de pago" readonly="1"/>
                    <field name="partner_id" string="Cliente" readonly="1" options="{'no_open': True, 'no_create_edit': True}"/> <!-- Cliente -->
                    <field name="commission_payable" readonly="1"/>
                    <field name="not_payable_reason" readonly="1" attrs="{'invisible': [('not_payable_reason', '=', False)]}"/>
                    <field name="payment_method" string="Forma de pago comisión" attrs="{'readonly': [('commission_payable', '=', False)]}"/> <!-- Se edita aquí (solo si es pagadera) -->
                    <!-- Aclaramos que esta fecha es de la comisión -->
                    <field name="payment_datetime" string="Fecha pago comisión" readonly="1"/> <!-- Fecha/hora del pago de la comisión -->
                    <field name="payment_user_id" string="Registró" readonly="1"/> <!-- Usuario que registró la comisión -->
                    <field name="amount_untaxed" string="Factura sin IVA" readonly="1"/>
                    <field name="commission_percent" string="% Comisión" readonly="1"/>
                    <field name="commission_amount" readonly="1"/>
                    <field name="commission_payable_amount" readonly="1"/>
                  </group>
                </form>
              </field>
            </page>

            <page string="Meta de Venta">
              <field name="has_goal" invisible="1"/>

              <!-- Vuelve a la pestaña "Facturas Comisionadas" (reabre el reporte) -->
              <div class="mb-3">
                <button name="action_back_to_report" type="object" string="Regresar"
                        class="btn-secondary" icon="fa-arrow-left"
                        help="Regresar al Reporte de Comisión de Ventas"/>
              </div>

              <div class="alert alert-warning" role="alert"
                   attrs="{'invisible': [('has_goal', '=', True)]}">
                No hay una meta de venta configurada para este vendedor en el periodo seleccionado.
                <span groups="sales_team.group_sale_manager">
                  Puedes configurarla en el menú "Metas de Venta".
                </span>
              </div>

              <group>
                <group string="Meta del periodo">
                  <field name="goal_total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                  <field name="achieved_total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                  <field name="remaining_total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                </group>
                <group string="Avance">
                  <field name="percent_goal" widget="percentpie" readonly="1"/>
                  <field name="achieved_total" nolabel="1" readonly="1"
                         widget="progressbar"
                         options="{'current_value': 'achieved_total', 'max_value': 'goal_total'}"/>
                </group>
              </group>

              <separator string="Unidades vendidas en el periodo"/>
              <!-- KPIs pulsables: abren el detalle por producto con gráfica y PDF -->
              <div class="oe_button_box">
                <button name="action_view_products_sold" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        help="Ver el detalle de los productos vendidos en el periodo">
                  <field name="qty_products_sold" widget="statinfo" string="Productos vendidos"/>
                </button>
                <button name="action_view_services_sold" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        help="Ver el detalle de los servicios vendidos en el periodo">
                  <field name="qty_services_sold" widget="statinfo" string="Servicios vendidos"/>
                </button>
              </div>
            </page>
          </notebook>
        </sheet>

        <footer>
          <!-- Consulta en pantalla (periodo de hasta un trimestre) -->
          <button name="action_save" type="object" string="Guardar" class="btn-primary"
                  attrs="{'invisible': [('is_large_period', '=', True)]}"/>
          <button name="action_mark_all_paid" type="object" string="Marcar todas como pagadas" class="oe_highlight"
                  attrs="{'invisible': [('is_large_period', '=', True)]}"/>
          <button name="action_open_enable_payment" type="object" string="Habilitar pago (plazo vencido)"
                  class="btn-secondary" icon="fa-unlock"
                  attrs="{'invisible': [('is_large_period', '=', True)]}"
                  help="Habilitar para pago comisiones no pagaderas porque el cliente no pagó la factura completa dentro de 3 meses"/>
          <button name="action_print_pdf" type="object" string="Descargar PDF" class="btn-primary"
                  attrs="{'invisible': [('is_large_period', '=', True)]}"/>
          <!-- Periodo extenso: se genera en segundo plano y llega por correo -->
          <button name="action_request_by_email" type="object" string="Enviar reporte a mi correo"
                  class="btn-primary" icon="fa-paper-plane"
                  attrs="{'invisible': ['|', ('is_large_period', '=', False), ('request_id', '!=', False)]}"/>
          <button string="Cerrar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ===== Wizard: Marcar comisiones pagadas (masivo) ===== -->
  <record id="view_commission_mass_pay_wizard_form" model="ir.ui.view">
    <field name="name">commission.mass.pay.wizard.form</field>
    <field name="model">commission.mass.pay.wizard</field>
    <field name="arch" type="xml">
      <form string="Marcar comisiones como pagadas">
        <group>
          <field name="payment_method" required="1"/>
          <!-- AQUÍ el nombre correcto según tu Python -->
          <field name="payment_datetime"/>
          <field name="note"/>
        </group>
        <group>
          <field name="entry_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Aplicar" class="oe_highlight"/>
          <button string="Cancelar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ===== Wizard: Habilitar pago de comisiones no pagaderas ===== -->
  <record id="view_commission_enable_payment_wizard_form" model="ir.ui.view">
    <field name="name">commission.enable.payment.wizard.form</field>
    <field name="model">commission.enable.payment.wizard</field>
    <field name="arch" type="xml">
      <form string="Habilitar pago de comisiones no pagaderas">
        <field name="report_wizard_id" invisible="1"/>
        <div class="alert alert-warning" role="alert">
          Estas comisiones no son pagaderas porque el cliente no pagó la factura completa
          dentro de 3 meses. Marque las que desea habilitar para pago; quedará registrado
          quién las habilitó y cuándo.
        </div>
        <field name="line_ids" nolabel="1">
          <tree editable="bottom" create="0" delete="0">
            <field name="selected" widget="boolean_toggle"/>
            <field name="move_id" readonly="1" options="{'no_open': True}"/>
            <field name="invoice_date" readonly="1"/>
            <field name="partner_id" readonly="1" options="{'no_open': True}"/>
            <field name="currency_id" invisible="1"/>
            <field name="commission_amount" readonly="1"/>
            <field name="reason" readonly="1"/>
          </tree>
        </field>
        <footer>
          <button name="action_confirm" type="object" string="Habilitar seleccionadas" class="oe_highlight"
                  confirm="¿Estás seguro que deseas marcarlas para pagar aunque el plazo de los 3 meses ya venció?"/>
          <button name="action_select_all" type="object" string="Seleccionar todas" class="btn-secondary"/>
          <button name="action_back_to_report" type="object" string="Regresar" class="btn-secondary" icon="fa-arrow-left"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ===== Reportes enviados por correo (periodos extensos) ===== -->
  <record id="view_commission_report_request_tree" model="ir.ui.view">
    <field name="name">commission.report.request.tree</field>
    <field name="model">commission.report.request</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" decoration-muted="state == 'done'" decoration-danger="state == 'error'"
            decoration-info="state in ('pending', 'processing')">
        <field name="create_date" string="Solicitado"/>
        <field name="requested_by_id" optional="show"/>
        <field name="salesperson_id"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="filter_payment" optional="hide"/>
        <field name="email_to" optional="show"/>
        <field name="state" widget="badge"
               decoration-success="state == 'done'" decoration-danger="state == 'error'"
               decoration-info="state in ('pending', 'processing')"/>
        <field name="date_done" optional="show"/>
      </tree>
    </field>
  </record>

  <record id="view_commission_report_request_form" model="ir.ui.view">
    <field name="name">commission.report.request.form</field>
    <field name="model">commission.report.request</field>
    <field name="arch" type="xml">
      <form create="0" edit="0">
        <header>
          <field name="state" widget="statusbar" statusbar_visible="pending,processing,done"/>
        </header>
        <sheet>
          <group>
            <group string="Lo que se seleccionó">
              <field name="salesperson_id"/>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="filter_payment"/>
            </group>
            <group string="Envío">
              <field name="requested_by_id"/>
              <field name="email_to"/>
              <field name="create_date" string="Solicitado"/>
              <field name="date_done"/>
              <field name="attachment_id" attrs="{'invisible': [('attachment_id', '=', False)]}"/>
            </group>
          </group>
          <field name="error_message" attrs="{'invisible': [('state', '!=', 'error')]}" class="text-danger"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_commission_report_request" model="ir.actions.act_window">
    <field name="name">Reportes enviados por correo</field>
    <field name="res_model">commission.report.request</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Aún no has pedido reportes por correo</p>
      <p>Cuando consultas en el Reporte de Comisión de Ventas un periodo de más de 100 días,
         se genera en segundo plano y te llega por correo. Aquí puedes ver si ya se envió.</p>
    </field>
  </record>

  <!-- Acción para abrir el wizard principal -->
  <act_window id="action_commission_report_wizard" name="Reporte de Comisión de Ventas" res_model="commission.report.wizard" view_mode="form" target="new"/>

  <!-- Menú -->
  <menuitem id="menu_commission_report_root" name="Comisiones de Ventas" sequence="100" groups="crm_commission.group_commission_view" web_icon="crm_commission,static/description/icon_commission.svg"/>
  <menuitem id="menu_commission_report_wizard" name="Reporte de Comisión de Ventas" parent="menu_commission_report_root" action="action_commission_report_wizard" sequence="10" groups="crm_commission.group_commission_view"/>
  <menuitem id="menu_commission_report_request" name="Reportes enviados por correo" parent="menu_commission_report_root" action="action_commission_report_request" sequence="11" groups="crm_commission.group_commission_view"/>
</odoo>
