<odoo>

  <record id="view_commission_units_detail_form" model="ir.ui.view">
    <field name="name">commission.units.detail.form</field>
    <field name="model">commission.units.detail.wizard</field>
    <field name="arch" type="xml">
      <form string="Unidades vendidas">
        <sheet>
          <field name="currency_id" invisible="1"/>
          <field name="unit_type" invisible="1"/>

          <div class="oe_title">
            <h2>
              <field name="user_id" readonly="1" options="{'no_open': True}" nolabel="1"/>
            </h2>
            <h4 class="text-muted">
              <field name="date_start" readonly="1" nolabel="1" class="oe_inline"/>
              <span class="mx-1">→</span>
              <field name="date_end" readonly="1" nolabel="1" class="oe_inline"/>
            </h4>
          </div>

          <group>
            <group string="Resumen">
              <field name="total_qty" readonly="1"/>
              <field name="product_count" readonly="1"/>
            </group>
            <group string="Facturado (sin IVA)">
              <field name="total_amount" readonly="1" widget="monetary"
                     options="{'currency_field': 'currency_id'}"/>
            </group>
          </group>

          <separator string="Más vendidos"/>
          <field name="chart_html" nolabel="1" readonly="1"/>

          <separator string="Detalle por producto"/>
          <field name="line_ids" nolabel="1" readonly="1">
              <tree create="0" edit="0" delete="0" default_order="quantity desc">
                <field name="default_code" string="Referencia" optional="show"/>
                <field name="product_name" string="Producto"/>
                <field name="uom_name" string="UdM" optional="hide"/>
                <field name="quantity" string="Unidades" sum="Total unidades"/>
                <field name="share" string="% del total" optional="show"/>
                <field name="invoice_count" string="Facturas" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount_untaxed" string="Importe sin IVA" sum="Total"/>
              </tree>
          </field>
        </sheet>

        <footer>
          <button name="action_print_pdf" type="object" string="Descargar PDF" class="btn-primary"/>
          <button string="Cerrar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>
